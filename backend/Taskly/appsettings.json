{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "<conn_str>"
  },
  "Cors": {
    "Headers": [
      "*"
    ],
    "ExposedHeaders": [
      "*"
    ],
    "Methods": [
      "*"
    ],
    "Origins": [
      "http://localhost:3000"
    ],
    "AllowCredentials": true
  }
}
